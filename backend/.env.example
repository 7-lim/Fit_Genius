# Copy to `.env` and fill in. NEVER commit the real .env.

# Required for the AI coach (step 8). Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional overrides (defaults shown)
# GROQ_MODEL=llama-3.1-8b-instant      # llama3-8b-8192 is decommissioned on Groq
# FLASK_ENV=development
# MODEL_DIR=models/
# DATABASE_URL=sqlite:///fitgenius.db
# CORS_ORIGINS=http://localhost:4200
# HOST=127.0.0.1
# PORT=5000
# MAX_UPLOAD_MB=100
